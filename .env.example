# Copy to .env and fill in. Never commit .env.
# Every value below is a placeholder or a local-dev default.

# --- Anthropic (classification + extraction, Phase 3) ---
ANTHROPIC_API_KEY=
# Model names are only ever read from here, never hardcoded. Example values:
#   ANTHROPIC_MODEL_CLASSIFY=claude-haiku-5-5   (every document: type + small non-NDA field sets)
#   ANTHROPIC_MODEL_EXTRACT=claude-sonnet-5-5   (NDAs only: the full field set)
ANTHROPIC_MODEL_CLASSIFY=
ANTHROPIC_MODEL_EXTRACT=
# How hard each model thinks (low | medium | high | xhigh | max). Empty = the model's default.
ANTHROPIC_EFFORT_CLASSIFY=low
ANTHROPIC_EFFORT_EXTRACT=medium
# The SDK retries rate limits, server errors and dropped connections this often, with backoff.
ANTHROPIC_MAX_RETRIES=4
# Spend cap in USD. `make extract` stops before a call that could go over it. The extract worker
# applies it per UTC day.
MAX_SPEND_USD=1.00
# false: uploads are parsed but never sent to the API by themselves (run `make extract`).
EXTRACT_ON_PARSE=false
# Routing: below these confidences a document goes to needs_review, even if every check passed.
CLASSIFY_MIN_CONFIDENCE=0.8
FIELD_MIN_CONFIDENCE=0.8
# Fields read by OCR need more (OCR can drop a line while still reporting high confidence).
OCR_FIELD_MIN_CONFIDENCE=0.9
# Parallel extraction processes in the extractor container (they mostly wait on the API).
EXTRACTOR_CONCURRENCY=4

# --- Postgres ---
POSTGRES_USER=lexintake
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lexintake
# Inside Docker the host is "db"; from your Mac use localhost.
DATABASE_URL=postgresql://lexintake:change-me@db:5432/lexintake

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- API ---
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# Uploads larger than this are rejected with 413.
MAX_UPLOAD_MB=50

# --- Ingestion & parsing (Phase 2) ---
# Where original files are stored, by SHA-256. Compose overrides this with a Docker volume.
BLOB_DIR=./.blobs
# Folder the watcher ingests from (compose mounts ./inbox there).
INBOX_DIR=./inbox
# A document that keeps crashing the worker is marked failed after this many attempts.
PARSE_MAX_ATTEMPTS=3
# Parallel parse processes in the worker container. Each one loads the models (~1 GB RAM).
WORKER_CONCURRENCY=2

# --- Frontend ---
# Browser -> API (inlined into the JS bundle at build time).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Next.js server -> API (Docker service name, never seen by the browser).
API_URL_INTERNAL=http://api:8000

# --- Host ports (change these if something else on your Mac already uses them) ---
# If you change API_PORT or FRONTEND_PORT, update NEXT_PUBLIC_API_URL and CORS_ORIGINS to match.
DB_PORT=5432
REDIS_PORT=6379
API_PORT=8000
FRONTEND_PORT=3000
